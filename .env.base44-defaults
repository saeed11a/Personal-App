# Public, non-secret defaults for the Base44 sandbox dev server.
#
# Listed FIRST in the compose `env_file:` chain, so any value the user configures
# in the Base44 dashboard (delivered at /run/base44/app.env, listed last) always
# wins. Never put a user-supplied credential here.
#
# These are frontend (Vite) values: only VITE_-prefixed keys reach the browser
# bundle. Never add SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_URL here or to any
# VITE_-prefixed name.

# Existing Supabase project (public URL, not a secret).
VITE_SUPABASE_URL=https://heqxvqgztkaixtgezbcw.supabase.co

# Which backend signs users in: 'supabase' or 'base44' (default). The sandbox has no
# linked Base44 app, so the preview runs the Supabase auth + five-digit PIN flow.
VITE_AUTH_BACKEND=supabase

# Supabase publishable (anon) key — supplied securely as an app secret.
# Left empty on purpose: the app must not ship a guessed key.
VITE_SUPABASE_PUBLISHABLE_KEY=
