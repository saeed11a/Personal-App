{
  "name": "ProductionEntry",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string"
    },
    "article_code": {
      "type": "string"
    },
    "article_name": {
      "type": "string"
    },
    "production_date": {
      "type": "string",
      "format": "date"
    },
    "line": {
      "type": "string",
      "description": "Production line"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Day",
        "Night",
        "Morning",
        "Evening"
      ]
    },
    "operator": {
      "type": "string"
    },
    "input_bags": {
      "type": "number",
      "description": "Uppers bags issued to production"
    },
    "pairs_per_bag": {
      "type": "number"
    },
    "uppers_used_pairs": {
      "type": "number",
      "description": "input bags x pairs per bag"
    },
    "carton_type": {
      "type": "string"
    },
    "pairs_per_carton": {
      "type": "number"
    },
    "output_cartons": {
      "type": "number"
    },
    "output_pairs": {
      "type": "number",
      "description": "output cartons x pairs per carton"
    },
    "notes": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "article_id",
    "uppers_used_pairs",
    "output_pairs"
  ]
}
