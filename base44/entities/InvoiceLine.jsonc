{
  "name": "InvoiceLine",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "article_id": {
      "type": "string"
    },
    "article_code": {
      "type": "string"
    },
    "article_name": {
      "type": "string"
    },
    "carton_type": {
      "type": "string"
    },
    "pairs_per_carton": {
      "type": "number"
    },
    "cartons": {
      "type": "number"
    },
    "pairs": {
      "type": "number",
      "description": "cartons x pairs per carton"
    },
    "price_per_pair": {
      "type": "number"
    },
    "line_total": {
      "type": "number"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "invoice_id",
    "pairs"
  ]
}
