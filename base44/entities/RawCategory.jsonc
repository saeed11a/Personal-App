{
  "name": "RawCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name, e.g. Sole Sheets"
    },
    "slug": {
      "type": "string",
      "description": "URL key, e.g. sole-sheets"
    },
    "description": {
      "type": "string"
    },
    "unit_label": {
      "type": "string",
      "description": "Default measuring unit for this category"
    },
    "uses_pairs": {
      "type": "boolean",
      "default": false,
      "description": "Convert quantity into total pairs"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "select",
              "date"
            ],
            "default": "text"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "description": "Custom fields defined for this category"
    },
    "sort_order": {
      "type": "number",
      "default": 10
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}

