# Copy to `.env.local` for local development. `.env*` files are gitignored —
# never commit real values.
#
# Vite only exposes VITE_-prefixed variables to the browser. Privileged values
# (service_role key, database password) must never be added here.

# --- Supabase (target backend, already exists) ---
# Project URL is public.
VITE_SUPABASE_URL=https://heqxvqgztkaixtgezbcw.supabase.co
# Publishable (anon) key: Supabase dashboard > Project Settings > API keys.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Which backend signs users in ---
# 'base44' (default — what the shipped APK/EXE use today) or 'supabase' (the
# migration target, with the five-digit PIN unlock). Explicit so a build never
# switches backend by accident.
VITE_AUTH_BACKEND=base44

# --- Base44 (current backend, kept until every module is migrated) ---
# App id is in the Builder URL: app.base44.com/apps/<id>/...
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# --- Server-side only (no VITE_ prefix — never in the web bundle or a build) ---
# Used from the sandbox / CI for privileged work: bootstrapping the first
# administrator, applying migrations, inspecting RLS, deploying the admin-users
# Edge Function. Placeholder names only; the real values are supplied as
# platform secrets and land in the managed env file, never in this repo.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
